rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
        request.auth.token.email == 'vishseenarain@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // 1. users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['role', 'email', 'createdAt']) &&
               data.role in ['admin', 'client'] &&
               data.email is string && data.email.size() <= 255 &&
               (data.get('displayName', '') is string) && (data.get('displayName', '').size() <= 100) &&
               (data.get('companyName', '') is string) && (data.get('companyName', '').size() <= 160) &&
               (data.get('phone', '') is string) && (data.get('phone', '').size() <= 40) &&
               (data.get('status', 'active') is string) && data.get('status', 'active') in ['prospect', 'agreed', 'lost', 'active', 'inactive'] &&
               (!('updatedAt' in data) || data.updatedAt is timestamp) &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isValidId(userId) && 
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidUser(incoming()) &&
                       incoming().createdAt == request.time &&
                       (incoming().role == 'client' || isAdmin());

      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (isAdmin() || (request.auth.uid == userId && incoming().role == existing().role && incoming().status == existing().status));

      allow delete: if isAdmin();
    }

    // 2. projects Collection
    match /projects/{projectId} {
       function isValidProject(data) {
          return data.keys().hasAll(['clientId', 'name', 'phase', 'createdAt', 'updatedAt']) &&
                 data.clientId is string && data.clientId.size() <= 128 &&
                 data.name is string && data.name.size() <= 200 &&
                 data.phase is string && data.phase.size() <= 100 &&
                 (data.get('timeline', '') is string) && (data.get('timeline', '').size() <= 500) &&
                 (data.get('agreedPayment', 0) is number) &&
                 (data.get('remainingPayment', 0) is number) &&
                 data.createdAt is timestamp &&
                 data.updatedAt is timestamp;
       }

       allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid);
       allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);

       allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                        exists(/databases/$(database)/documents/users/$(incoming().clientId)) &&
                        incoming().createdAt == request.time &&
                        incoming().updatedAt == request.time;
       
       allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().clientId == existing().clientId &&
                        incoming().updatedAt == request.time;

       allow delete: if isAdmin();
    }

    // 3. documents Collection
    match /documents/{documentId} {
       function isValidDocument(data) {
           return data.keys().hasAll(['clientId', 'type', 'title', 'url', 'createdAt']) &&
                  data.clientId is string && data.clientId.size() <= 128 &&
                  (data.get('projectId', '') is string) && (data.get('projectId', '').size() <= 128) &&
                  data.type in ['quotation', 'proposal', 'invoice', 'onboarding', 'contract', 'discovery', 'satisfaction', 'other'] &&
                  data.title is string && data.title.size() <= 250 &&
                  data.url is string && data.url.size() <= 2048 &&
                  (data.get('signatureData', {}) is map || data.get('signatureData', '') is string) &&
                  (data.get('isSigned', false) is bool) &&
                  data.createdAt is timestamp;
       }

       allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid || existing().clientId == 'global');
       allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid || resource.data.clientId == 'global');

       allow create: if isAdmin() && isValidId(documentId) && isValidDocument(incoming()) &&
                        (incoming().clientId == 'global' || exists(/databases/$(database)/documents/users/$(incoming().clientId))) &&
                        incoming().createdAt == request.time;

       allow update: if isSignedIn() && isValidId(documentId) && isValidDocument(incoming()) &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().clientId == existing().clientId &&
                        (isAdmin() || (request.auth.uid == existing().clientId && incoming().diff(existing()).affectedKeys().hasOnly(['isSigned', 'signatureData'])));

       allow delete: if isAdmin();
    }

    // 4. messages Collection
    match /messages/{messageId} {
       function isValidMessage(data) {
           return data.keys().hasAll(['clientId', 'senderId', 'text', 'createdAt']) &&
                  data.clientId is string && data.clientId.size() <= 128 &&
                  data.senderId is string && data.senderId.size() <= 128 &&
                  (data.get('projectId', '') is string) && (data.get('projectId', '').size() <= 128) &&
                  data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
                  data.createdAt is timestamp;
       }

       allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid);
       allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);

       allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
                        (isAdmin() || request.auth.uid == incoming().clientId) &&
                        incoming().senderId == request.auth.uid &&
                        incoming().createdAt == request.time &&
                        exists(/databases/$(database)/documents/users/$(incoming().clientId));

       allow update: if false; 
       allow delete: if isAdmin();
    }
    // 5. tasks Collection
    match /tasks/{taskId} {
       function isValidTask(data) {
           return data.keys().hasAll(['clientId', 'title', 'completed', 'createdAt']) &&
                  data.clientId is string && data.clientId.size() <= 128 &&
                  data.title is string && data.title.size() <= 200 &&
                  data.completed is bool &&
                  data.createdAt is timestamp;
       }

       allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid);
       allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);
       allow create: if isAdmin() && isValidId(taskId) && isValidTask(incoming()) &&
                        exists(/databases/$(database)/documents/users/$(incoming().clientId)) &&
                        incoming().createdAt == request.time;
       allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().clientId == existing().clientId &&
                        (isAdmin() || (request.auth.uid == existing().clientId && incoming().diff(existing()).affectedKeys().hasOnly(['completed'])));
       allow delete: if isAdmin();
    }

    // 6. expenses Collection
    match /expenses/{expenseId} {
       function isValidExpense(data) {
           return data.keys().hasAll(['amount', 'description', 'createdAt']) &&
                  data.amount is number &&
                  data.description is string && data.description.size() <= 500 &&
                  data.createdAt is timestamp;
       }
       allow read, write: if isAdmin();
    }

    // 7. settings Collection
    match /settings/{settingId} {
       allow read: if isSignedIn();
       allow write: if isAdmin();
    }
  }
}
