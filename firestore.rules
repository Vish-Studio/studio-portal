// Generated by scripts/build-firestore-rules.mjs.
// Edit files in firestore-rules/ instead of editing this file directly.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net. Collection files below opt into access explicitly.
    match /{document=**} {
      allow read, write: if false;
    }

// Primitive helpers shared by collection rules.
    function isSignedIn() { return request.auth != null; }

    // Admin = hardcoded owner emails OR users/{uid}.role is admin/superadmin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
        request.auth.token.email == 'vishseenarain@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'freelancer'])
      );
    }

    function currentRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isManager() {
      return isSignedIn() && (
        request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
        request.auth.token.email == 'vishseenarain@gmail.com' ||
        currentRole() in ['admin', 'superadmin']
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // users/{uid} — identity document keyed by Firebase Auth UID.
    // Canonical user schema uses camelCase fields only.
    match /users/{userId} {

      function isValidUser(data) {
        return data.uid   is string &&
               data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 255 &&
               data.role  in ['admin', 'superadmin', 'team', 'client', 'freelancer'] &&
               data.needsPasswordChange is bool;
      }

      // Any signed-in user can read their own profile; admins can read all
      allow get:  if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow list: if isAdmin();

      // Admin creates profiles (provisioning) OR owner bootstraps their own
      // profile on first login (e.g. hardcoded admin emails).
      allow create: if isSignedIn() &&
                       isValidUser(incoming()) &&
                       userId == incoming().uid &&
                       (
                         isAdmin() ||
                         userId == request.auth.uid
                       );

      // Admin can update anything; owner can only clear the password-change flag
      // or update their own non-role/email/uid fields.
      allow update: if isSignedIn() &&
                       isValidUser(incoming()) &&
                       incoming().uid   == existing().get('uid', userId) &&
                       (
                         isAdmin() ||
                         (
                           userId == request.auth.uid &&
                           incoming().email == existing().email &&
                           incoming().role == existing().role &&
                           incoming().needsPasswordChange == false
                         )
                       );

      allow delete: if isAdmin();
    }

    // projects: client work and process state.
    match /projects/{projectId} {
      function isValidProject(data) {
        return data.keys().hasAll(['clientId', 'name', 'phase', 'createdAt', 'updatedAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.name is string && data.name.size() <= 200 &&
               data.phase is string && data.phase.size() <= 100 &&
               (data.get('timeline', '') is string) && (data.get('timeline', '').size() <= 500) &&
               (data.get('agreedPayment', 0) is number) &&
               (data.get('remainingPayment', 0) is number) &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);

      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;

      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // documents: client files and signed assets.
    match /documents/{documentId} {
      function isValidDocument(data) {
        return data.keys().hasAll(['clientId', 'type', 'title', 'url', 'createdAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               (data.get('projectId', '') is string) && (data.get('projectId', '').size() <= 128) &&
               data.type in ['quotation', 'proposal', 'invoice', 'onboarding', 'contract', 'discovery', 'satisfaction', 'other'] &&
               data.title is string && data.title.size() <= 250 &&
               data.url is string && data.url.size() <= 2048 &&
               (data.get('signatureData', {}) is map || data.get('signatureData', '') is string) &&
               (data.get('isSigned', false) is bool) &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid || existing().clientId == 'global');
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid || resource.data.clientId == 'global');

      allow create: if isAdmin() && isValidId(documentId) && isValidDocument(incoming()) &&
                      (incoming().clientId == 'global' || exists(/databases/$(database)/documents/clients/$(incoming().clientId))) &&
                      incoming().createdAt == request.time;

      allow update: if isSignedIn() && isValidId(documentId) && isValidDocument(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      (isAdmin() || (request.auth.uid == existing().clientId && incoming().diff(existing()).affectedKeys().hasOnly(['isSigned', 'signatureData'])));

      allow delete: if isAdmin();
    }

    // messages: admin/client chat records.
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['clientId', 'senderId', 'text', 'createdAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.senderId is string && data.senderId.size() <= 128 &&
               (data.get('projectId', '') is string) && (data.get('projectId', '').size() <= 128) &&
               data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);

      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
                      (isAdmin() || request.auth.uid == incoming().clientId) &&
                      incoming().senderId == request.auth.uid &&
                      incoming().createdAt == request.time &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId));

      allow update: if false;
      allow delete: if isAdmin();
    }

    // tasks: admin-assigned and client-visible tasks.
    match /tasks/{taskId} {
      function isValidTask(data) {
        return data.keys().hasAll(['clientId', 'title', 'completed', 'createdAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.title is string && data.title.size() <= 200 &&
               data.completed is bool &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == request.auth.uid);

      allow create: if isAdmin() && isValidId(taskId) && isValidTask(incoming()) &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
                      incoming().createdAt == request.time;

      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      (isAdmin() || (request.auth.uid == existing().clientId && incoming().diff(existing()).affectedKeys().hasOnly(['completed'])));

      allow delete: if isAdmin();
    }

    // expenses: internal admin-only accounting data.
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // calendar: meetings visible to managers or invited users.
    match /calendar/{eventId} {
      function isValidCalendarEvent(data) {
        return data.keys().hasAll([
                 'category',
                 'type',
                 'title',
                 'time',
                 'date',
                 'allDay',
                 'createdById',
                 'createdByRole',
                 'invitees',
                 'createdAt',
                 'updatedAt'
               ]) &&
               data.category in ['team', 'project', 'client'] &&
               data.type is string && data.type.size() > 0 && data.type.size() <= 80 &&
               data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
               data.time is string && data.time.size() > 0 && data.time.size() <= 80 &&
               data.date is timestamp &&
               data.allDay is bool &&
               (data.get('startTime', '') is string) &&
               (data.get('endTime', '') is string) &&
               (data.get('callLink', '') is string) && data.get('callLink', '').size() <= 2048 &&
               (data.get('description', '') is string) && data.get('description', '').size() <= 2000 &&
               data.createdById == request.auth.uid &&
               data.createdByRole in ['admin', 'superadmin', 'freelancer', 'team', 'client'] &&
               data.invitees is list &&
               data.invitees.size() >= 2 &&
               data.invitees.size() <= 50 &&
               data.invitees.hasAny([request.auth.uid]) &&
               (data.get('projectId', '') is string) && data.get('projectId', '').size() <= 128 &&
               (data.get('phaseId', '') is string) && data.get('phaseId', '').size() <= 128 &&
               (data.get('clientId', '') is string) && data.get('clientId', '').size() <= 128 &&
               (data.get('memberIds', []) is list) && data.get('memberIds', []).size() <= 50 &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }

      function canWriteCalendarCategory(data) {
        return isManager() || (
          data.category == 'team' &&
          currentRole() in ['freelancer', 'team'] &&
          data.get('clientId', '') == ''
        );
      }

      allow get: if isSignedIn() && (isManager() || request.auth.uid in existing().invitees);
      allow list: if isSignedIn() && (isManager() || request.auth.uid in resource.data.invitees);

      allow create: if isSignedIn() &&
                      isValidId(eventId) &&
                      isValidCalendarEvent(incoming()) &&
                      canWriteCalendarCategory(incoming()) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                      existing().createdById == request.auth.uid &&
                      isValidId(eventId) &&
                      isValidCalendarEvent(incoming()) &&
                      canWriteCalendarCategory(incoming()) &&
                      incoming().createdById == existing().createdById &&
                      incoming().createdByRole == existing().createdByRole &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && existing().createdById == request.auth.uid;
    }

    // clients/{uid} — client profile keyed by Firebase Auth UID.
    // Schema: { id, companyName }
    // doc ID == user's Auth UID == /users/{uid}.uid
    match /clients/{clientId} {

      function isValidClient(data) {
        return data.keys().hasAll(['id', 'companyName']) &&
               data.id          is string && data.id == clientId &&
               data.companyName is string && data.companyName.size() <= 200;
      }

      // Admin sees all; client sees only their own record (doc ID = Auth UID)
      allow read: if isSignedIn() && (isAdmin() || clientId == request.auth.uid);

      allow create: if isAdmin() && isValidClient(incoming());
      allow update: if isAdmin() && isValidClient(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // team/{uid} — team member profile keyed by Firebase Auth UID.
    // Schema: { id, position }
    // doc ID == user's Auth UID == /users/{uid}.uid
    match /team/{memberId} {

      function isValidTeamMember(data) {
        return data.keys().hasAll(['id', 'position']) &&
               data.id       is string && data.id == memberId &&
               data.position is string && data.position.size() > 0 && data.position.size() <= 120;
      }

      // Admin sees all; team member sees only their own record (doc ID = Auth UID)
      allow read: if isSignedIn() && (isAdmin() || memberId == request.auth.uid);

      allow create: if isAdmin() && isValidTeamMember(incoming());
      allow update: if isAdmin() && isValidTeamMember(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Legacy teamMembers collection has been replaced by /team.
    match /teamMembers/{memberId} {
      allow read, write: if false;
    }

    // settings: app-level configuration.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
