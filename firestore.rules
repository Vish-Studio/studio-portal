// Generated by scripts/build-firestore-rules.mjs.
// Edit files in firestore-rules/ instead of editing this file directly.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net. Collection files below opt into access explicitly.
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers shared by collection rules.
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
        request.auth.token.email == 'vishseenarain@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'admin', 'freelancer'])
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
        request.auth.token.email == 'vishseenarain@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function currentClientId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId
        : '';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // users: Firebase auth profile source.
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['role', 'email', 'createdAt']) &&
               data.role in ['client', 'superadmin', 'admin', 'freelancer'] &&
               data.email is string && data.email.size() <= 255 &&
               (data.get('fullName', '') is string) && (data.get('fullName', '').size() <= 120) &&
               (data.get('staffRole', 'admin') is string) && data.get('staffRole', 'admin') in ['superadmin', 'admin', 'freelancer'] &&
               (data.get('teamMemberId', '') is string) && (data.get('teamMemberId', '').size() <= 128) &&
               (data.get('teamId', '') is string) && (data.get('teamId', '').size() <= 128) &&
               (data.get('clientId', '') is string) && (data.get('clientId', '').size() <= 128) &&
               (data.get('company', '') is string) && (data.get('company', '').size() <= 160) &&
               (data.get('phone', '') is string) && (data.get('phone', '').size() <= 40) &&
               (data.get('status', 'active') is string) && data.get('status', 'active') in ['prospect', 'agreed', 'lost', 'active', 'inactive'] &&
               (!('updatedAt' in data) || data.updatedAt is timestamp) &&
               data.createdAt is timestamp;
      }

      function isOwnUserProfile() {
        return request.auth.uid == userId || existing().email == request.auth.token.email;
      }

      function canWriteUserRole(data) {
        return isSuperAdmin() || (isAdmin() && data.role != 'superadmin');
      }

      function isValidUserProfileId(id) {
        return isValidId(id) || id == incoming().email || id == existing().email;
      }

      function hasStagedUserProfile() {
        return exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
               get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.email == request.auth.token.email &&
               get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == incoming().role;
      }

      allow get: if isSignedIn() && (isAdmin() || isOwnUserProfile());
      allow list: if isAdmin() || (isSignedIn() && existing().email == request.auth.token.email);

      allow create: if isSignedIn() && isValidUserProfileId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().createdAt == request.time &&
                       (
                         canWriteUserRole(incoming()) ||
                         (
                           request.auth.uid == userId &&
                           incoming().email == request.auth.token.email &&
                           (
                             request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
                             request.auth.token.email == 'vishseenarain@gmail.com' ||
                             hasStagedUserProfile()
                           )
                         )
                       );

      allow update: if isSignedIn() && isValidUserProfileId(userId) && isValidUser(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isSuperAdmin() ||
                         (isAdmin() && existing().role != 'superadmin' && incoming().role != 'superadmin') ||
                         (request.auth.uid == userId && incoming().role == existing().role && incoming().status == existing().status)
                       );

      allow delete: if isSuperAdmin() ||
                      (isAdmin() && existing().role != 'superadmin') ||
                      (isSignedIn() && userId == request.auth.token.email && existing().email == request.auth.token.email);
    }

    // projects: client work and process state.
    match /projects/{projectId} {
      function isValidProject(data) {
        return data.keys().hasAll(['clientId', 'name', 'phase', 'createdAt', 'updatedAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.name is string && data.name.size() <= 200 &&
               data.phase is string && data.phase.size() <= 100 &&
               (data.get('timeline', '') is string) && (data.get('timeline', '').size() <= 500) &&
               (data.get('agreedPayment', 0) is number) &&
               (data.get('remainingPayment', 0) is number) &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == currentClientId());
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == currentClientId());

      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;

      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // documents: client files and signed assets.
    match /documents/{documentId} {
      function isValidDocument(data) {
        return data.keys().hasAll(['clientId', 'type', 'title', 'url', 'createdAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               (data.get('projectId', '') is string) && (data.get('projectId', '').size() <= 128) &&
               data.type in ['quotation', 'proposal', 'invoice', 'onboarding', 'contract', 'discovery', 'satisfaction', 'other'] &&
               data.title is string && data.title.size() <= 250 &&
               data.url is string && data.url.size() <= 2048 &&
               (data.get('signatureData', {}) is map || data.get('signatureData', '') is string) &&
               (data.get('isSigned', false) is bool) &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == currentClientId() || existing().clientId == 'global');
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == currentClientId() || resource.data.clientId == 'global');

      allow create: if isAdmin() && isValidId(documentId) && isValidDocument(incoming()) &&
                      (incoming().clientId == 'global' || exists(/databases/$(database)/documents/clients/$(incoming().clientId))) &&
                      incoming().createdAt == request.time;

      allow update: if isSignedIn() && isValidId(documentId) && isValidDocument(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      (isAdmin() || (request.auth.uid == existing().clientId && incoming().diff(existing()).affectedKeys().hasOnly(['isSigned', 'signatureData'])));

      allow delete: if isAdmin();
    }

    // messages: admin/client chat records.
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['clientId', 'senderId', 'text', 'createdAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.senderId is string && data.senderId.size() <= 128 &&
               (data.get('projectId', '') is string) && (data.get('projectId', '').size() <= 128) &&
               data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == currentClientId());
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == currentClientId());

      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
                      (isAdmin() || currentClientId() == incoming().clientId) &&
                      incoming().senderId == request.auth.uid &&
                      incoming().createdAt == request.time &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId));

      allow update: if false;
      allow delete: if isAdmin();
    }

    // tasks: admin-assigned and client-visible tasks.
    match /tasks/{taskId} {
      function isValidTask(data) {
        return data.keys().hasAll(['clientId', 'title', 'completed', 'createdAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.title is string && data.title.size() <= 200 &&
               data.completed is bool &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (isAdmin() || existing().clientId == currentClientId());
      allow list: if isSignedIn() && (isAdmin() || resource.data.clientId == currentClientId());

      allow create: if isAdmin() && isValidId(taskId) && isValidTask(incoming()) &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
                      incoming().createdAt == request.time;

      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      (isAdmin() || (currentClientId() == existing().clientId && incoming().diff(existing()).affectedKeys().hasOnly(['completed'])));

      allow delete: if isAdmin();
    }

    // expenses: internal admin-only accounting data.
    match /expenses/{expenseId} {
      allow read, write: if isSuperAdmin();
    }

    // clients: client business data linked to users/{uid} by userId.
    match /clients/{clientId} {
      function isValidClient(data) {
        return data.keys().hasAll(['fullName', 'email', 'status', 'createdAt']) &&
               data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
               data.email is string && data.email.size() <= 255 &&
               (data.get('companyName', '') is string) && data.get('companyName', '').size() <= 160 &&
               (data.get('phone', '') is string) && data.get('phone', '').size() <= 40 &&
               (data.get('userId', '') == null || (data.get('userId', '') is string && data.get('userId', '').size() <= 128)) &&
               data.status in ['active', 'inactive', 'lost'] &&
               (!('updatedAt' in data) || data.updatedAt is timestamp) &&
               data.createdAt is timestamp;
      }

      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);

      allow create: if isValidClient(incoming()) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time &&
                      (
                        isAdmin() ||
                        (
                          isSignedIn() &&
                          currentClientId() == clientId &&
                          incoming().userId == request.auth.uid &&
                          incoming().email == request.auth.token.email
                        )
                      );

      allow update: if isSignedIn() && isValidClient(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      (
                        isAdmin() ||
                        (
                          existing().get('userId', null) == null &&
                          currentClientId() == clientId &&
                          incoming().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'updatedAt'])
                        ) ||
                        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
                          'fullName',
                          'email',
                          'phone',
                          'recoveryEmail',
                          'newsletterPreferences',
                          'updatedAt'
                        ]))
                      );

      allow delete: if isAdmin();
    }

    // team: team business data linked to users/{uid} by userId.
    match /team/{memberId} {
      function isValidTeamMember(data) {
        return data.keys().hasAll(['name', 'role', 'accessRole', 'email', 'assignedProjectId', 'createdAt']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
               data.role is string && data.role.size() > 0 && data.role.size() <= 120 &&
               data.accessRole in ['superadmin', 'admin', 'freelancer'] &&
               data.email is string && data.email.size() <= 255 &&
               (data.assignedProjectId == null || (data.assignedProjectId is string && data.assignedProjectId.size() <= 128)) &&
               (data.get('userId', '') == null || (data.get('userId', '') is string && data.get('userId', '').size() <= 128)) &&
               (!('updatedAt' in data) || data.updatedAt is timestamp) &&
               data.createdAt is timestamp;
      }

      allow read: if isAdmin();
      allow create: if isValidTeamMember(incoming()) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time &&
                      (
                        isSuperAdmin() ||
                        (isAdmin() && incoming().accessRole in ['admin', 'freelancer'])
                      );
      allow update: if isValidTeamMember(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      (
                        isSuperAdmin() ||
                        (isAdmin() && existing().accessRole != 'superadmin' && incoming().accessRole in ['admin', 'freelancer'])
                      );
      allow delete: if isSuperAdmin();
    }

    // Legacy teamMembers collection has been replaced by /team.
    match /teamMembers/{memberId} {
      allow read, write: if false;
    }

    // settings: app-level configuration.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
