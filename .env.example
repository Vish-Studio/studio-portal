
# Firebase web app config. Create these in Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""

# Comma-separated emails that should be treated as admins on first sign-in.
VITE_FIREBASE_ADMIN_EMAILS="vishstudio.ltd@gmail.com,vishseenarain@gmail.com"
