    // tasks: admin-assigned and client-visible tasks.
    match /tasks/{taskId} {
      function isTaskClient(data) {
        return currentRole() == 'user' && data.clientId == request.auth.uid;
      }

      function isAssignedToTask(data) {
        return request.auth.uid in data.get('assigneeIds', []);
      }

      function canCreateTask() {
        return currentRole() == 'superadmin';
      }

      function canUpdateTask(data) {
        return isManager();
      }

      function isValidTask(data) {
        return data.keys().hasAll(['clientId', 'projectId', 'title', 'status', 'priority', 'completed', 'createdAt', 'updatedAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.projectId is string && data.projectId.size() <= 128 &&
               data.title is string && data.title.size() <= 200 &&
               (data.get('description', '') is string) && data.get('description', '').size() <= 2000 &&
               data.status in ['todo', 'in-progress', 'review', 'done'] &&
               data.priority in ['low', 'medium', 'high'] &&
               data.completed is bool &&
               (data.get('assigneeIds', []) is list) && data.get('assigneeIds', []).size() <= 50 &&
               (data.get('assignedToId', '') is string) && data.get('assignedToId', '').size() <= 128 &&
               (data.get('clientAssigneeId', '') is string) && data.get('clientAssigneeId', '').size() <= 128 &&
               (data.get('visibleToClient', false) is bool) &&
               (!('dueDate' in data) || data.dueDate == null || data.dueDate is timestamp) &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }

      allow get: if isSignedIn() && (isManager() || isTaskClient(existing()) || isAssignedToTask(existing()));
      allow list: if isSignedIn() && (isManager() || isTaskClient(resource.data) || isAssignedToTask(resource.data));

      allow create: if isSignedIn() &&
                      canCreateTask() &&
                      isValidId(taskId) && isValidTask(incoming()) &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      incoming().updatedAt == request.time &&
                      (
                        canUpdateTask(existing()) ||
                        (isTaskClient(existing()) && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'status', 'updatedAt']))
                      );

      allow delete: if isManager();
    }
