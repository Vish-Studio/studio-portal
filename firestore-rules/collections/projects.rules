    // projects: client work and process state.
    match /projects/{projectId} {
      function isProjectClient(data) {
        return currentRole() == 'client' && data.clientId == request.auth.uid;
      }

      function isAssignedToProject(data) {
        return request.auth.uid in data.get('assignedTeamIds', []);
      }

      function isValidProject(data) {
        return data.keys().hasAll(['clientId', 'name', 'phase', 'createdAt', 'updatedAt']) &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.name is string && data.name.size() <= 200 &&
               data.phase is string && data.phase.size() <= 100 &&
               (data.get('timeline', '') is string) && (data.get('timeline', '').size() <= 500) &&
               (data.get('agreedPayment', 0) is number) &&
               (data.get('remainingPayment', 0) is number) &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }

      allow get: if isSignedIn() && (isManager() || isProjectClient(existing()) || isAssignedToProject(existing()));
      allow list: if isSignedIn() && (isManager() || isProjectClient(resource.data) || isAssignedToProject(resource.data));

      allow create: if isSignedIn() &&
                      (isManager() || isProjectClient(incoming())) &&
                      isValidId(projectId) && isValidProject(incoming()) &&
                      exists(/databases/$(database)/documents/clients/$(incoming().clientId)) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                      (isManager() || isProjectClient(existing())) &&
                      isValidId(projectId) && isValidProject(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().clientId == existing().clientId &&
                      incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && (isManager() || isProjectClient(existing()));
    }
