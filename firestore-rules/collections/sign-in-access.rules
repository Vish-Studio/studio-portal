    // signInAccess: invitation/first-login bridge by normalized email.
    match /signInAccess/{emailId} {
      function isValidAccess(data) {
        return data.keys().hasAll(['email', 'profileRole', 'fullName', 'status']) &&
               data.email == emailId &&
               data.email is string && data.email.size() <= 255 &&
               data.profileRole in ['client', 'superadmin', 'admin', 'freelancer'] &&
               (data.get('staffRole', 'admin') is string) && data.get('staffRole', 'admin') in ['superadmin', 'admin', 'freelancer'] &&
               (data.get('teamMemberId', '') is string) && data.get('teamMemberId', '').size() <= 128 &&
               (data.get('teamId', '') is string) && data.get('teamId', '').size() <= 128 &&
               (data.get('clientId', '') is string) && data.get('clientId', '').size() <= 128 &&
               data.fullName is string && data.fullName.size() <= 120 &&
               data.status in ['active', 'inactive'] &&
               (!('createdAt' in data) || data.createdAt is timestamp) &&
               (!('updatedAt' in data) || data.updatedAt is timestamp);
      }

      function canManageClientAccess(data) {
        return isSignedIn() &&
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'admin'] &&
               data.profileRole == 'client';
      }

      allow get: if true;
      allow list: if false;
      allow create, update: if isValidAccess(incoming()) &&
                              (isSuperAdmin() || canManageClientAccess(incoming()));
      allow delete: if isSuperAdmin();
    }
