    // users/{uid} — identity document keyed by Firebase Auth UID.
    // Canonical user schema uses camelCase fields only.
    match /users/{userId} {

      function isValidUser(data) {
        return data.uid   is string &&
               data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 255 &&
               data.role  in ['admin', 'superadmin', 'team', 'client', 'freelancer'] &&
               data.needsPasswordChange is bool;
      }

      // Any signed-in user can read their own profile; admins can read all
      allow get:  if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow list: if isAdmin();

      // Admin creates profiles (provisioning) OR owner bootstraps their own
      // profile on first login (e.g. hardcoded admin emails).
      allow create: if isSignedIn() &&
                       isValidUser(incoming()) &&
                       userId == incoming().uid &&
                       (
                         isAdmin() ||
                         userId == request.auth.uid
                       );

      // Admin can update anything; owner can only clear the password-change flag
      // or update their own non-role/email/uid fields.
      allow update: if isSignedIn() &&
                       isValidUser(incoming()) &&
                       incoming().uid   == existing().get('uid', userId) &&
                       (
                         isAdmin() ||
                         (
                           userId == request.auth.uid &&
                           incoming().email == existing().email &&
                           incoming().role == existing().role &&
                           incoming().needsPasswordChange == false
                         )
                       );

      allow delete: if isAdmin();
    }
