// Primitive helpers shared by collection rules.
    function isSignedIn() { return request.auth != null; }

    // Superadmin = hardcoded owner emails OR users/{uid}.role is superadmin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
        request.auth.token.email == 'vishseenarain@gmail.com' ||
        request.auth.token.email == 'vishroy@vish.studio' ||
        request.auth.token.email == 'divesh@vish.studio' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function currentRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isManager() {
      return isSignedIn() && (
        request.auth.token.email == 'vishstudio.ltd@gmail.com' ||
        request.auth.token.email == 'vishseenarain@gmail.com' ||
        request.auth.token.email == 'vishroy@vish.studio' ||
        request.auth.token.email == 'divesh@vish.studio' ||
        currentRole() == 'superadmin'
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
